<Window x:Class="ISIP423_Marinin_SPA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP423_Marinin_SPA"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Frame x:Name="MainFrame" Grid.Row="1" Source="Pages/StartPage.xaml" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BackButton" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="20" Click="BackButton_Click">Назад</Button>
            <Button x:Name="HomeButton" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="20" Click="HomeButton_Click">Главная</Button>
        </StackPanel>
        <Button x:Name="AccountButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Width="100" Height="20" Click="AccountButton_Click"></Button>
        <TextBlock x:Name="DateTimeNow"
            HorizontalAlignment="Right"
            Grid.Row="2"
            Margin="20"
        VerticalAlignment="Bottom"/>
        <Button x:Name="StyleButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="30" Height="30" Content="☼" Margin="10 10 10 50" Click="StyleButton_Click"></Button>
    </Grid>
</Window>
