<Page x:Class="ISIP423_Marinin_SPA.Pages.AppointmentConfirmationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentConfirmationPage"
      Language="ru-RU">

    <Page.Resources>
        <local:ImagePathConverter x:Key="ImgConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding Services.Name}"/>

        <Border Grid.Column="0" Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="10" Margin="10">
            <StackPanel VerticalAlignment="Top">
                <Border BorderThickness="1" BorderBrush="LightGray" Height="180" Margin="0 0 0 10">
                    <Image Source="{Binding Services.Users.ImagePath, Converter={StaticResource ImgConverter}}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Border CornerRadius="20"
                        Background="Black"
                        Width="{Binding RelativeSource={RelativeSource AncestorType=Image}, Path=ActualWidth}"
                        Height="{Binding RelativeSource={RelativeSource AncestorType=Image}, Path=ActualHeight}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Image.OpacityMask>
                    </Image>
                </Border>
                <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Services.Users.Name}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="{Binding Services.Users.Phone, StringFormat=Телефон: {0}}" HorizontalAlignment="Center" Margin="0 2"/>
                <TextBlock Text="{Binding Services.Users.Email, StringFormat=E-mail: {0}}" HorizontalAlignment="Center" Margin="0 2"/>
                <Button Width="150" Height="28" Content="Страница мастера" Click="MasterButton_Click" HorizontalAlignment="Center" Margin="0 10 0 0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="10" Margin="10">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="Информация об услуге" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Services.Name}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 5"/>
                <TextBlock Text="{Binding Services.Description}" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0 5"/>
                <TextBlock Text="{Binding Services.Price, StringFormat={}{0} Руб.}" HorizontalAlignment="Center" FontWeight="Bold" Margin="0 5"/>
                <TextBlock Text="{Binding Date, StringFormat={}{0:d MMMM}}" HorizontalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" HorizontalAlignment="Center" FontSize="9" Foreground="Gray"/>
                <TextBlock Text="{Binding Date, StringFormat={}{0:HH:mm}}" HorizontalAlignment="Center" FontSize="22" Margin="0 5"/>
                <Button Height="35" Width="200" Margin="0 20 0 0" Click="Button_Click" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center">Записаться</Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>