<Page x:Class="ISIP423_Marinin_SPA.Pages.UsersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UsersTabPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="377*"/>
            <RowDefinition Height="73*"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="1" x:Name="DataGridUser" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="50"/>
                <DataGridTextColumn Header="Пароль" Binding="{Binding Password}" Width="70"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding UserType.Name}" Width="80"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Фото" Binding="{Binding ImagePath}" Width="50"/>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" Content="Редактировать" ToolTip="Редактировать данные" Click="ButtonEdit_Click"></Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="ButtonAdd" Padding="15" ToolTip="Добавить данные" Content="Добавить" Click="ButtonAdd_Click"/>
            <Button x:Name="ButtonDel" Padding="15" ToolTip="Удалить данные" Content="Удалить" Click="ButtonDel_Click"/>
        </StackPanel>
    </Grid>
</Page>
