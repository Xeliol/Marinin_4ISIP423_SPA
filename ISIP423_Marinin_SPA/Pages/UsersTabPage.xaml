<Page x:Class="ISIP423_Marinin_SPA.Pages.UsersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UsersTabPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Page.Resources>
        <local:ImagePathConverter x:Key="ImgConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Text="Пользователи"/>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Margin="10">
            <DataGrid x:Name="DataGridUser" AutoGenerateColumns="False"
                      IsReadOnly="True" BorderThickness="0" RowHeight="50">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Логин"  Binding="{Binding Login}"  Width="100"/>
                    <DataGridTextColumn Header="Пароль" Binding="{Binding Password}" Width="150"/>
                    <DataGridTextColumn Header="Роль"   Binding="{Binding UserType.Name}" Width="90"/>
                    <DataGridTextColumn Header="ФИО"    Binding="{Binding Name}" Width="*"/>

                    <DataGridTemplateColumn Header="Фото" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImagePath, Converter={StaticResource ImgConverter}}"
                                       Width="40" Height="40" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Редактировать" Click="ButtonEdit_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="10">
            <Button x:Name="ButtonAdd" Width="150" Height="35"
                    Content="Добавить" Click="ButtonAdd_Click" Margin="10"/>
            <Button x:Name="ButtonDel" Width="150" Height="35"
                    Content="Удалить" Click="ButtonDel_Click" Margin="10"/>
        </StackPanel>
    </Grid>
</Page>