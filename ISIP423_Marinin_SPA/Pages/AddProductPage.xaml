<Page x:Class="ISIP423_Marinin_SPA.Pages.AddProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="800"
      Title="AddProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Text="Добавление товара"/>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="15" Margin="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0 6" HorizontalAlignment="Center">
                        <TextBlock Text="Название товара:" FontSize="14" Width="220" VerticalAlignment="Center"/>
                        <TextBox x:Name="TBName" Width="350" Height="28"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Введите название товара" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 6" HorizontalAlignment="Center">
                        <TextBlock Text="Тип товара:" FontSize="14" Width="220" VerticalAlignment="Center"/>
                        <ComboBox Name="cmbType" Width="350" Height="28"
                                  SelectedValue="{Binding TypeID, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="TypeID" DisplayMemberPath="Name"
                                  ToolTip="Выберите тип товара" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 6" HorizontalAlignment="Center">
                        <TextBlock Text="Производитель:" FontSize="14" Width="220" VerticalAlignment="Center"/>
                        <ComboBox Name="cmbManufacturer" Width="350" Height="28"
                                  SelectedValue="{Binding ManufacturerID, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="ManufacturerID" DisplayMemberPath="Name"
                                  ToolTip="Выберите производителя" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 6" HorizontalAlignment="Center">
                        <TextBlock Text="Цена:" FontSize="14" Width="220" VerticalAlignment="Center"/>
                        <TextBox x:Name="TBPrice" Width="350" Height="28"
                                 Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Введите цену (целое число)" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 6" HorizontalAlignment="Center">
                        <TextBlock Text="Скидка (%):" FontSize="14" Width="220" VerticalAlignment="Center"/>
                        <TextBox x:Name="TBSale" Width="350" Height="28"
                                 Text="{Binding Sale, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Введите скидку" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 6" HorizontalAlignment="Center">
                        <TextBlock Text="Описание:" FontSize="14" Width="220" VerticalAlignment="Center"/>
                        <TextBox x:Name="TBDescription" Width="350" Height="28"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Введите описание товара" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 6" HorizontalAlignment="Center">
                        <TextBlock Text="Путь к фото:" FontSize="14" Width="220" VerticalAlignment="Center"/>
                        <TextBox x:Name="TBPhoto" Width="350" Height="28"
                                 ToolTip="Добавьте путь к фото" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 15 0 0">
                        <Button x:Name="ButtonSave" Content="Сохранить" Width="150" Height="35" Margin="10" Click="ButtonSave_Click"/>
                        <Button x:Name="ButtonClean" Content="Очистить" Width="150" Height="35" Margin="10" Click="ButtonClean_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>