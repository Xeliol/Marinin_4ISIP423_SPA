<Page x:Class="ISIP423_Marinin_SPA.Pages.AddProductTypePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddProductTypePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Text="Тип товара"/>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="20" Margin="15">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0 10" HorizontalAlignment="Center">
                    <TextBlock Text="Название типа:" FontSize="16" Width="180" VerticalAlignment="Center"/>
                    <TextBox x:Name="TBName" Width="300" Height="28"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Введите название типа товара" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
                    <Button x:Name="ButtonSave" Content="Сохранить" Width="150" Height="35" Margin="10" Click="ButtonSave_Click"/>
                    <Button x:Name="ButtonClean" Content="Очистить" Width="150" Height="35" Margin="10" Click="ButtonClean_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>