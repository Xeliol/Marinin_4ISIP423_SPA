<Page x:Class="ISIP423_Marinin_SPA.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChangePassPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Text="Смена пароля"/>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="20" Margin="15">
            <Viewbox Stretch="Uniform" MaxHeight="500">
                <StackPanel Width="400" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0 8" HorizontalAlignment="Center">
                        <TextBlock FontSize="16" Text="Логин: " Width="180" VerticalAlignment="Center"/>
                        <TextBox x:Name="TbLogin" Width="200" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 8" HorizontalAlignment="Center">
                        <TextBlock FontSize="16" Text="Текущий пароль: " Width="180" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="CurrentPasswordBox" Width="200" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 8" HorizontalAlignment="Center">
                        <TextBlock FontSize="16" Text="Новый пароль: " Width="180" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="NewPasswordBox" Width="200" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 8" HorizontalAlignment="Center">
                        <TextBlock FontSize="16" Text="Подтверждение: " Width="180" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" Width="200" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnSave" Margin="0 20 0 10" Width="200" Height="35" Content="Сохранить изменения" Click="BtnSave_Click" HorizontalAlignment="Center"/>
                    <Button x:Name="BtnCancel" Width="200" Height="35" Content="Отмена" Click="BtnCancel_Click" HorizontalAlignment="Center"/>
                </StackPanel>
            </Viewbox>
        </Border>
    </Grid>
</Page>