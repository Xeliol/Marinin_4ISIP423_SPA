<Page x:Class="ISIP423_Marinin_SPA.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChangePassPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="24" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center">Смена пароля</TextBlock>

        <Viewbox Grid.Row="1" Stretch="Uniform" MaxHeight="600">
            <StackPanel Width="350">
                <StackPanel Margin="0 8" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontSize="16" Text="Логин: " VerticalAlignment="Center"/>
                    <TextBox x:Name="TbLogin" Width="200" Height="25"></TextBox>
                </StackPanel>
                <StackPanel Margin="0 8" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontSize="16" Text="Текущий пароль: " VerticalAlignment="Center"/>
                    <PasswordBox x:Name="CurrentPasswordBox" Width="200" Height="25"></PasswordBox>
                </StackPanel>

                <StackPanel Margin="0 8" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontSize="16" Text="Новый пароль: " VerticalAlignment="Center"/>
                    <PasswordBox x:Name="NewPasswordBox" Width="200" Height="25"></PasswordBox>
                </StackPanel>

                <StackPanel Margin="0 8" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontSize="16" Text="Подтверждение: " VerticalAlignment="Center"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Width="200" Height="25"></PasswordBox>
                </StackPanel>

                <Button x:Name="BtnSave" Margin="0 15" Width="150" Height="30" Content="Сохранить изменения" Click="BtnSave_Click" HorizontalAlignment="Center"></Button>
                <Button x:Name="BtnCancel" Width="150" Height="25" Content="Отмена" Click="BtnCancel_Click" HorizontalAlignment="Center"></Button>
            </StackPanel>
        </Viewbox>
    </Grid>
</Page>
