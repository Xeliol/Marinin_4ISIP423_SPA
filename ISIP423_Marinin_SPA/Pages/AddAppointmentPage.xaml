<Page x:Class="ISIP423_Marinin_SPA.Pages.AddAppointmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="AddAppointmentPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Выбор клиента:" Grid.Row="1" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Выбор услуги:" Grid.Row="2" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Дата записи:" Grid.Row="3" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Время (ЧЧ:ММ):" Grid.Row="4" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Статус бронирования:" Grid.Row="5" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>

        <ComboBox Name="cmbUser" 
          SelectedValue="{Binding UserID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
          SelectedValuePath="UserID" 
          DisplayMemberPath="Name" 
          Grid.Row="1" Grid.Column="1" 
          ToolTip="Выберите клиента" 
          Margin="10,5,50,5" 
          VerticalContentAlignment="Center"/>


        <ComboBox Name="cmbService" 
                  SelectedValue="{Binding ServiceID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                  SelectedValuePath="ServiceID" 
                  DisplayMemberPath="Name" 
                  Grid.Row="2" Grid.Column="1" ToolTip="Выберите услугу" Margin="10,5,50,5" VerticalContentAlignment="Center"/>

        <DatePicker Name="DPDate" Grid.Row="3" Grid.Column="1" ToolTip="Выберите дату" Margin="10,5,50,5" VerticalContentAlignment="Center"/>

        <TextBox x:Name="TBTime" Grid.Row="4" Grid.Column="1" ToolTip="Введите время в формате ЧЧ:ММ (например, 14:30)" Margin="10,5,50,5" VerticalContentAlignment="Center"/>

        <CheckBox x:Name="ChBReserved" IsChecked="{Binding Reserved, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Content="Подтвердить бронь" Grid.Row="5" Grid.Column="1" Margin="10,5,50,5" VerticalAlignment="Center" FontSize="16"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button x:Name="ButtonSave" Content="Сохранить" Width="150" Height="35" Click="ButtonSave_Click" Margin="0,0,20,0"/>
            <Button x:Name="ButtonClean" Content="Очистить" Width="150" Height="35" Click="ButtonClean_Click" Margin="0,0,20,0"/>
        </StackPanel>
    </Grid>
</Page>
