<Page x:Class="ISIP423_Marinin_SPA.Pages.AddAppointmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="800"
      Title="AddAppointmentPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Text="Добавление записи"/>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="20" Margin="15">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0 8" HorizontalAlignment="Center">
                    <TextBlock Text="Клиент:" FontSize="16" Width="220" VerticalAlignment="Center"/>
                    <ComboBox Name="cmbUser" Width="350" Height="28"
                              SelectedValue="{Binding UserID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              SelectedValuePath="UserID" DisplayMemberPath="Name"
                              ToolTip="Выберите клиента" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 8" HorizontalAlignment="Center">
                    <TextBlock Text="Услуга:" FontSize="16" Width="220" VerticalAlignment="Center"/>
                    <ComboBox Name="cmbService" Width="350" Height="28"
                              SelectedValue="{Binding ServiceID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              SelectedValuePath="ServiceID" DisplayMemberPath="Name"
                              ToolTip="Выберите услугу" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 8" HorizontalAlignment="Center">
                    <TextBlock Text="Дата записи:" FontSize="16" Width="220" VerticalAlignment="Center"/>
                    <DatePicker Name="DPDate" Width="350" Height="28" ToolTip="Выберите дату" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 8" HorizontalAlignment="Center">
                    <TextBlock Text="Время (ЧЧ:ММ):" FontSize="16" Width="220" VerticalAlignment="Center"/>
                    <TextBox x:Name="TBTime" Width="350" Height="28" ToolTip="Введите время в формате ЧЧ:ММ (например, 14:30)" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 8" HorizontalAlignment="Center">
                    <TextBlock Text="Статус бронирования:" FontSize="16" Width="220" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChBReserved" Content="Подтвердить бронь" FontSize="14"
                              IsChecked="{Binding Reserved, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
                    <Button x:Name="ButtonSave" Content="Сохранить" Width="150" Height="35" Margin="10" Click="ButtonSave_Click"/>
                    <Button x:Name="ButtonClean" Content="Очистить" Width="150" Height="35" Margin="10" Click="ButtonClean_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>