<Page x:Class="ISIP423_Marinin_SPA.Pages.AppointmentsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentsTabPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Text="Записи"/>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Margin="10">
            <DataGrid x:Name="DataGridAppointments" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№ Записи" Binding="{Binding AppointmentID}" Width="80"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding Users.Name}" Width="200"/>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding Services.Name}" Width="200"/>
                    <DataGridTextColumn Header="Дата и время" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                    <DataGridCheckBoxColumn Header="Бронь" Binding="{Binding Reserved}" Width="80"/>
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="ButtonEdit" Content="Редактировать" Click="ButtonEdit_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="ButtonAdd" Width="150" Height="35" Content="Добавить" Click="ButtonAdd_Click" Margin="10"/>
            <Button x:Name="ButtonDel" Width="150" Height="35" Content="Удалить" Click="ButtonDel_Click" Margin="10"/>
        </StackPanel>
    </Grid>
</Page>