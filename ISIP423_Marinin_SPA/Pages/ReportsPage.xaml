<Page x:Class="ISIP423_Marinin_SPA.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReportsPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" FontSize="24" FontWeight="Bold" VerticalAlignment="Top" TextAlignment="Center">Отчёты</TextBlock>
        <Button x:Name="OrdersDynamic" Grid.Column="0" Grid.Row="1" Margin="30" FontSize="24" FontWeight="Bold" Click="OrdersDynamic_Click" >Динамика заказов</Button>
        <Button x:Name="ServicesPopularity" Grid.Column="1" Grid.Row="1" Margin="30" FontSize="24" FontWeight="Bold" Click="ServicesPopularity_Click">Востребованность сервисов</Button>
        <Button x:Name="ProductTypes" Grid.Column="2" Grid.Row="1" Margin="30" FontSize="24" FontWeight="Bold" Click="ProductTypes_Click">Категории товаров</Button>
        <Button x:Name="MastersLoad" Grid.Column="1" Grid.Row="2" Margin="30" FontSize="24" FontWeight="Bold" Click="MastersLoad_Click">Нагрузка мастеров</Button>
    </Grid>
</Page>
