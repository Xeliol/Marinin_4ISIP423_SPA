<Page x:Class="ISIP423_Marinin_SPA.Pages.MasterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MasterPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Text="Мастер"/>

        <Border Grid.Column="0" Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="10" Margin="10">
            <StackPanel x:Name="MoviePanel" VerticalAlignment="Top">
                <Border BorderThickness="1" BorderBrush="LightGray" Height="180" Margin="0 0 0 10">
                    <Image Source="{Binding ImagePath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Name}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="{Binding Phone, StringFormat=Телефон: {0}}" HorizontalAlignment="Center" Margin="0 2"/>
                <TextBlock Text="{Binding Email, StringFormat=E-mail: {0}}" HorizontalAlignment="Center" Margin="0 2"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="10" Margin="10">
            <StackPanel>
                <TextBlock Text="Услуги" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 10"/>
                <ListBox x:Name="ServicesListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="Gray" Padding="8" Margin="0 3">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Name}" HorizontalAlignment="Left"/>
                                    <TextBlock FontSize="13" Text="{Binding Description}" TextWrapping="Wrap" Margin="0 5"/>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Price, StringFormat=Стоимость: {0} руб.}" HorizontalAlignment="Left" Margin="0 0 0 5"/>
                                    <Button Width="120" Height="25" Click="Button_Click" HorizontalAlignment="Left" Content="Записаться"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</Page>