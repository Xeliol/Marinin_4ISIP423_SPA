<Page x:Class="ISIP423_Marinin_SPA.Pages.AddOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddOrderPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Пользователь/Клиент:" Grid.Row="1" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Желаемая дата:" Grid.Row="2" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Тип оплаты:" Grid.Row="3" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Статус доставки:" Grid.Row="4" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>

        <ComboBox Name="cmbUser" 
                  Grid.Row="1" Grid.Column="1" 
                  SelectedValue="{Binding UserID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                  SelectedValuePath="UserID" 
                  DisplayMemberPath="Name" 
                  ToolTip="Выберите пользователя" Margin="10,5,50,5" VerticalContentAlignment="Center"/>

        <DatePicker Name="dpPreferedDate" 
                    Grid.Row="2" Grid.Column="1" 
                    SelectedDate="{Binding PreferedDate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                    ToolTip="Выберите дату" Margin="10,5,50,5" VerticalContentAlignment="Center"/>

        <ComboBox Name="cmbPaymentType" 
                  Grid.Row="3" Grid.Column="1" 
                  SelectedValue="{Binding PaymentTypeID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                  SelectedValuePath="PaymentTypeID" 
                  DisplayMemberPath="Name" 
                  ToolTip="Выберите тип оплаты" Margin="10,5,50,5" VerticalContentAlignment="Center"/>

        <CheckBox Name="cbDelivered" 
                  Content="Доставлено" 
                  Grid.Row="4" Grid.Column="1" 
                  IsChecked="{Binding Delivered, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                  FontSize="16" Margin="10,5,50,5" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,20">
            <Button x:Name="ButtonSave" Content="Сохранить" Width="150" Height="35" Margin="10,0" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonClean" Content="Очистить" Width="150" Height="35" Margin="10,0" Click="ButtonClean_Click"/>
        </StackPanel>
    </Grid>
</Page>