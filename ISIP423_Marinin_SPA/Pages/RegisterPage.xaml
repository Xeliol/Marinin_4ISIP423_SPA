<Page x:Class="ISIP423_Marinin_SPA.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="24" TextAlignment="Center" FontWeight="Bold">Регистрация</TextBlock>
        <StackPanel Grid.Row="1" Margin="0 30" Width="450">
            <TextBlock FontSize="18" FontWeight="Bold" Text="Регистрация" HorizontalAlignment="Center"/>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="ФИО: " HorizontalAlignment="Center"/>
                <TextBox x:Name="NameBox" Width="200" ToolTip="Введите ФИО"></TextBox>
            </StackPanel>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="Логин: " HorizontalAlignment="Center"/>
                <TextBox x:Name="LoginBox" Width="200" ToolTip="Введите логин"></TextBox>
            </StackPanel>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="Пароль: " HorizontalAlignment="Center"/>
                <PasswordBox x:Name="PassBox1" Width="200" ToolTip="Введите пароль"></PasswordBox>
            </StackPanel>
            <TextBlock FontSize="10" Text="Пароль ОБЯЗАН быть на английском не менее 6 символов длиной, хотя бы одну букву и цифру." HorizontalAlignment="Center"/>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="Повторите пароль: " HorizontalAlignment="Center"/>
                <PasswordBox x:Name="PassBox2" Width="200" ToolTip="Введите пароль снова"></PasswordBox>
            </StackPanel>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="Телефон: " HorizontalAlignment="Center"/>
                <TextBox x:Name="PhoneBox" Width="200" ToolTip="Введите телефон"></TextBox>
            </StackPanel>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="E-mail*: " HorizontalAlignment="Center"/>
                <TextBox x:Name="EmailBox" Width="200" ToolTip="Введите почту"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="12" Text="Уже есть аккаунт?" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Margin="5 10" Click="LogInButton_Click">Войдите!</Button>
            </StackPanel>
            <Button x:Name="SignupButton" Margin="0 10" Width="140" Click="SignupButton_Click">Зарегистрироваться</Button>
        </StackPanel>
    </Grid>
</Page>
