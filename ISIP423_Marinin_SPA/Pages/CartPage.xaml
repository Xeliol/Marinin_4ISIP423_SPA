<Page x:Class="ISIP423_Marinin_SPA.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage">

    <Page.Resources>
        <local:ImagePathConverter x:Key="ImgConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Text="Корзина"/>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Margin="10" Padding="10">
            <StackPanel>
                <ListBox x:Name="CartListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="Gray" Padding="8" Margin="0 5">
                                <Grid Height="110" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderThickness="1" BorderBrush="LightGray" Width="120" Height="100" VerticalAlignment="Center">
                                        <Image Source="{Binding ImagePath, Converter={StaticResource ImgConverter}}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" FontSize="16" FontWeight="Bold" Text="{Binding Name}"
                                               VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="10,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0">
                                        <TextBlock Foreground="#dd4842" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Price, StringFormat={}{0} Руб.}"/>
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Sale}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="16" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="Скидка: {0}% Цена: {1} Руб.">
                                                                <Binding Path="Sale"/>
                                                                <Binding Path="FinalPrice"/>
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Sale}" Value="0">
                                                            <Setter Property="Text" Value="{Binding Price, StringFormat={}{0} Руб.}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="3" Width="50" Height="50" FontSize="24" FontWeight="Bold"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Foreground="White" Background="#dd4842" Content="✕" Click="RemoveButton_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock x:Name="Price" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="0 20 0 0">Итоговая цена:</TextBlock>
                <Button Height="40" Width="150" Click="Button_Click" FontSize="18" Margin="10" HorizontalAlignment="Center">Заказать</Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>