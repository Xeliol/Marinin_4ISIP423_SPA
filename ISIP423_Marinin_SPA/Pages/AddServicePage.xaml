<Page x:Class="ISIP423_Marinin_SPA.Pages.AddServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddServicePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Название услуги:" Grid.Row="1" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Категория услуги:" Grid.Row="2" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock x:Name="LBMaster" Text="Закрепленный мастер:" Grid.Row="3" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Стоимость (руб.):" Grid.Row="4" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Описание:" Grid.Row="5" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>

        <TextBox x:Name="TBName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" ToolTip="Введите название услуги" Margin="10,5,50,5" VerticalContentAlignment="Center"/>

        <ComboBox Name="cmbType" 
                  SelectedValue="{Binding TypeID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                  SelectedValuePath="TypeID" 
                  DisplayMemberPath="Name" 
                  Grid.Row="2" Grid.Column="1" ToolTip="Выберите тип услуги" Margin="10,5,50,5" VerticalContentAlignment="Center"/>

        <!-- Выбор мастера (Доступен только для Администратора) -->
        <ComboBox Name="cmbMaster" 
                  SelectedValue="{Binding MasterID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                  SelectedValuePath="UserID" 
                  DisplayMemberPath="Name" 
                  Grid.Row="3" Grid.Column="1" ToolTip="Выберите мастера" Margin="10,5,50,5" VerticalContentAlignment="Center"/>

        <TextBox x:Name="TBPrice" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" ToolTip="Введите стоимость (только цифры)" Margin="10,5,50,5" VerticalContentAlignment="Center"/>
        <TextBox x:Name="TBDescription" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="1" ToolTip="Введите описание услуги" Margin="10,5,50,5" VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button x:Name="ButtonSave" Content="Сохранить" Width="150" Height="35" Click="ButtonSave_Click" Margin="0,0,20,0"/>
            <Button x:Name="ButtonClean" Content="Очистить" Width="150" Height="35" Click="ButtonClean_Click" Margin="0,0,20,0"/>
        </StackPanel>
    </Grid>
</Page>
