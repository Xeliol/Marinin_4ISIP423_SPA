<Page x:Class="ISIP423_Marinin_SPA.Pages.AddServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddServicePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Text="Добавление услуги"/>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="20" Margin="15">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0 6" HorizontalAlignment="Center">
                    <TextBlock Text="Название услуги:" FontSize="14" Width="220" VerticalAlignment="Center"/>
                    <TextBox x:Name="TBName" Width="350" Height="28"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Введите название услуги" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 6" HorizontalAlignment="Center">
                    <TextBlock Text="Категория услуги:" FontSize="14" Width="220" VerticalAlignment="Center"/>
                    <ComboBox Name="cmbType" Width="350" Height="28"
                              SelectedValue="{Binding TypeID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              SelectedValuePath="TypeID" DisplayMemberPath="Name"
                              ToolTip="Выберите тип услуги" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 6" HorizontalAlignment="Center">
                    <TextBlock x:Name="LBMaster" Text="Закрепленный мастер:" FontSize="14" Width="220" VerticalAlignment="Center"/>
                    <ComboBox Name="cmbMaster" Width="350" Height="28"
                              SelectedValue="{Binding MasterID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              SelectedValuePath="UserID" DisplayMemberPath="Name"
                              ToolTip="Выберите мастера" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 6" HorizontalAlignment="Center">
                    <TextBlock Text="Стоимость (руб.):" FontSize="14" Width="220" VerticalAlignment="Center"/>
                    <TextBox x:Name="TBPrice" Width="350" Height="28"
                             Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Введите стоимость (только цифры)" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 6" HorizontalAlignment="Center">
                    <TextBlock Text="Описание:" FontSize="14" Width="220" VerticalAlignment="Center"/>
                    <TextBox x:Name="TBDescription" Width="350" Height="28"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Введите описание услуги" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 15 0 0">
                    <Button x:Name="ButtonSave" Content="Сохранить" Width="150" Height="35" Margin="10" Click="ButtonSave_Click"/>
                    <Button x:Name="ButtonClean" Content="Очистить" Width="150" Height="35" Margin="10" Click="ButtonClean_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>