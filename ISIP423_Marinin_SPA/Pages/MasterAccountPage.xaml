<Page x:Class="ISIP423_Marinin_SPA.Pages.MasterAccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MasterAccountPage">
    
    <Page.Resources>
        <local:ImagePathConverter x:Key="ImgConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Text="Аккаунт Мастера"/>

        <Border Grid.Column="0" Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="10" Margin="10">
            <StackPanel x:Name="MoviePanel" VerticalAlignment="Top">
                <Border BorderThickness="1" BorderBrush="LightGray" Height="180" Margin="0 0 0 10">
                    <Image x:Name="UserPhotoImage" Source="{Binding ImagePath, Converter={StaticResource ImgConverter}}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="ChangePhotoButton" Content="Изменить фото" Width="150" Height="28" HorizontalAlignment="Center" Margin="0 0 0 10" Click="ChangePhotoButton_Click"/>
                <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Login, StringFormat=Логин: {0}}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Phone, StringFormat=Телефон: {0}}" HorizontalAlignment="Center" Margin="0 2"/>
                <TextBlock Text="{Binding Email, StringFormat=E-mail: {0}}" HorizontalAlignment="Center" Margin="0 2"/>
                <Button x:Name="LogOutButton" Width="150" Height="30" Content="Выйти" Click="LogOutButton_Click" HorizontalAlignment="Center" Margin="0 15 0 0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="10" Margin="10">
            <StackPanel>
                <TextBlock Text="Записи" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Button x:Name="ManageAppointmentsButton" Content="Управление записями" Width="180" Height="30"
                        Margin="0 10 0 10" Click="ManageAppointmentsButton_Click" HorizontalAlignment="Center"/>
                <ListBox x:Name="SessionListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="Gray" Padding="6" Margin="0 3">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" Margin="10 0">
                                        <TextBlock Text="{Binding Date, StringFormat={}{0:d MMMM}}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" HorizontalAlignment="Center" FontSize="9" Foreground="Gray"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Date, StringFormat={}{0:HH:mm}}" Margin="10" VerticalAlignment="Center" FontSize="20"/>
                                    <TextBlock Text="{Binding Users.Name}" Margin="10" VerticalAlignment="Center"/>
                                    <Button Width="100" Height="28" Click="FinishButton_Click" Content="Закрыть"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="10" Margin="10">
            <StackPanel>
                <TextBlock Text="Услуги" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Button x:Name="ManageServicesButton" Content="Управление услугами" Width="180" Height="30"
                        Margin="0 10 0 10" Click="ManageServicesButton_Click" HorizontalAlignment="Center"/>
                <ListBox x:Name="ServiceListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="Gray" Padding="8" Margin="0 3">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Description}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0} Руб.}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</Page>