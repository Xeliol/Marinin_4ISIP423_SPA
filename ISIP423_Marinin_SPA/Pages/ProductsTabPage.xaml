<Page x:Class="ISIP423_Marinin_SPA.Pages.ProductsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ISIP423_Marinin_SPA.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductsTabPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Page.Resources>
        <local:ImagePathConverter x:Key="ImgConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Text="Товары"/>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Margin="10">
            <DataGrid x:Name="DataGridProducts" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" RowHeight="50">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding ProductTypes.Name}" Width="100"/>
                    <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturers.Name}" Width="120"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="70"/>
                    <DataGridTextColumn Header="Скидка" Binding="{Binding Sale}" Width="60"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="200"/>
                    <DataGridTemplateColumn Header="Фото" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImagePath, Converter={StaticResource ImgConverter}}"
                                       Width="40" Height="40" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="ButtonEdit" Content="Редактировать" Click="ButtonEdit_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="ButtonAdd" Width="150" Height="35" Content="Добавить" Click="ButtonAdd_Click" Margin="10"/>
            <Button x:Name="ButtonDel" Width="150" Height="35" Content="Удалить" Click="ButtonDel_Click" Margin="10"/>
        </StackPanel>
    </Grid>
</Page>