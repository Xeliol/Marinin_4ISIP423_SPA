<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style
        TargetType="Button">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="10pt"/>
        <Setter Property="Background" Value="#006b80"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Open Sans" />
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Open Sans" />
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="#193d57" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Open Sans" />
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="#193d57"/>
    </Style>

    <Style TargetType="Grid">
        <Setter Property="Background" Value="#193d57"/>
    </Style>

    <DataTemplate x:Key="ComboBoxTextTemplate">
        <TextBlock Text="{Binding}" Foreground="#000000" FontFamily="Open Sans"/>
    </DataTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Open Sans" />
        <Setter Property="Background" Value="#193d57" />
        <Setter Property="ItemTemplate" Value="{StaticResource ComboBoxTextTemplate}"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#000000"/>
            </Style>
        </Style.Resources>
    </Style>

</ResourceDictionary>