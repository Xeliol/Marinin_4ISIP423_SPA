<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Frame x:Name="MainFrame" Grid.Row="1" Source="Pages/StartPage.xaml" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BackButton" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="20" Click="BackButton_Click" BorderBrush="White" BorderThickness="2" Background="MediumPurple" Foreground="White">Go Back</Button>
            <Button x:Name="HomeButton" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="20" Click="HomeButton_Click" BorderBrush="White" BorderThickness="2" Background="MediumPurple" Foreground="White">Home</Button>
        </StackPanel>
        <Button x:Name="AccountButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Width="100" Height="20" BorderBrush="White" BorderThickness="2" Background="MediumPurple" Foreground="White" Click="AccountButton_Click"></Button>
    </Grid>
</Window>
