<Page x:Class="WpfApp1.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="AddUserPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Логин:" Grid.Row="1" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Пароль:" Grid.Row="2" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Роль:" Grid.Row="3" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="ФИО:" Grid.Row="4" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Фото (необязательно):" Grid.Row="5" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Телефон:" Grid.Row="6" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Text="Почта (необязательно):" Grid.Row="7" Grid.Column="0" Margin="20,0,0,0" FontSize="18" VerticalAlignment="Center"/>

        <TextBox x:Name="TBLogin" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" ToolTip="Введите логин" Margin="10,5,50,5" VerticalContentAlignment="Center"/>
        <TextBox x:Name="TBPass" Grid.Row="2" Grid.Column="1" ToolTip="Введите пароль" Margin="10,5,50,5" VerticalContentAlignment="Center"/>
        <ComboBox Name="cmbRole" 
          Grid.Row="3" 
          Grid.Column="1" 
          SelectedValue="{Binding TypeID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
          SelectedValuePath="TypeID" 
          DisplayMemberPath="Name" 
          ToolTip="Выберите роль" 
          Margin="10,5,50,5" 
          VerticalContentAlignment="Center"/>
        <TextBox x:Name="TBFio" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" ToolTip="Введите ФИО" Margin="10,5,50,5" VerticalContentAlignment="Center"/>
        <TextBox x:Name="TBPhoto" Grid.Row="5" Grid.Column="1" ToolTip="Добавьте путь к фото" Margin="10,5,50,5" VerticalContentAlignment="Center"/>
        <TextBox x:Name="TBPhone" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" ToolTip="Введите телефон" Margin="10,5,50,5" VerticalContentAlignment="Center"/>
        <TextBox x:Name="TBEmail" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Grid.Row="7" Grid.Column="1" ToolTip="Введите почту" Margin="10,5,50,5" VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ButtonSave" Content="Сохранить" Width="150" Height="35" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonClean" Content="Очистить" Width="150" Height="35" Click="ButtonClean_Click"/>
        </StackPanel>
    </Grid>
</Page>
