<Page x:Class="WpfApp1.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddUserPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Логин" Grid.Row="1" Grid.Column="0" Margin="10,0,0,0" FontSize="20" />
        <TextBlock Text="Пароль" Grid.Row="2" Grid.Column="0" Margin="10,0,0,0" FontSize="20" />
        <TextBlock Text="Роль" Grid.Row="3" Grid.Column="0" Margin="10,0,0,0" FontSize="20" />
        <TextBlock Text="ФИО" Grid.Row="4" Grid.Column="0" Margin="10,0,0,0" FontSize="20" />
        <TextBlock Text="Фото (необязательно)" Grid.Row="4" Grid.Column="0" Margin="10,64,573,0" FontSize="20" Grid.ColumnSpan="2" Grid.RowSpan="2" />
        <TextBlock Text="Телефон" Grid.Row="6" Grid.Column="0" Margin="10,0,0,0" FontSize="20" />
        <TextBlock Text="Почта (необязательно)" Grid.Row="7" Grid.Column="0" Margin="10,0,0,0" FontSize="20" Grid.ColumnSpan="2"/>
        <TextBox x:Name="TBLogin" Text="{Binding Login}" Grid.Row="1" ToolTip="Введите логин" Grid.Column="1" Margin="156,5,71,5" />
        <TextBox x:Name="TBPass" Text="{Binding Password}" Grid.Row="2" Grid.Column="1" ToolTip="Введите пароль" Margin="156,5,71,5" />
        <ComboBox Name="cmbRole" ToolTip="Выберите роль"  Grid.Row="3" Grid.Column="1" Margin="156,5,71,5"/>
        <TextBox x:Name="TBFio" Text="{Binding Name}" Grid.Row="4" ToolTip="Введите ФИО" Grid.Column="1" Margin="156,5,71,5" />
        <TextBox x:Name="TBPhoto" Text="{Binding ImagePath}" Grid.Row="5" ToolTip="Добавте фото" Grid.Column="1" Margin="156,5,71,4" />
        <TextBox x:Name="TBPhone" Text="{Binding Phone}" Grid.Row="6" ToolTip="Введите телефон" Grid.Column="1" Margin="156,5,71,4" />
        <TextBox x:Name="TBEmail" Text="{Binding Email}" Grid.Row="7" ToolTip="Введите почту" Grid.Column="1" Margin="156,5,71,4" />
        <Button x:Name="ButtonSave" Content="Сохранить" Grid.Row="8" Click="ButtonSave_Click" Grid.ColumnSpan="2" Margin="0,0,50,0" HorizontalAlignment="Right" />
        <Button x:Name="ButtonClean" Content="Очистить" Grid.Row="8" Click="ButtonClean_Click" Grid.ColumnSpan="2" Margin="50,0,0,0" HorizontalAlignment="Left" />
    </Grid>
</Page>
