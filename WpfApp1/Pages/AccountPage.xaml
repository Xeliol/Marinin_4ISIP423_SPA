<Page x:Class="WpfApp1.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccountPage">

    <Grid Background="FloralWhite">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" FontSize="24" FontWeight="Bold" VerticalAlignment="Top" Foreground="White" Background="MediumPurple" TextAlignment="Center">Account</TextBlock>
        <StackPanel x:Name="MoviePanel" Grid.Column="0" Grid.Row="1" VerticalAlignment="Top">
            <Image Source="{Binding ImagePath}" Width="Auto"/>
            <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Login, StringFormat=Name: {0}}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Phone, StringFormat=Phone: {0}}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Email, StringFormat=Email: {0}}" HorizontalAlignment="Center"/>
            <Button x:Name="LogOutButton"  Width="100" BorderBrush="White" BorderThickness="2" Background="MediumPurple" Foreground="White" Click="LogOutButton_Click">Log Out</Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <TextBlock Text="Appointments" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
            <ListBox x:Name="SessionListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0 30 0 0" Background="FloralWhite">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                        <StackPanel Orientation="Horizontal" Height="100" HorizontalAlignment="Center">
                            <StackPanel Margin="30 0">
                                <TextBlock Text="{Binding Services.Name}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Services.Description}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Services.Price, StringFormat={}{0} Rub.}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="30 0">
                                <TextBlock Text="{Binding Services.Users.Name}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image Source="{Binding Services.Users.ImagePath}" Width="90"/>
                            </StackPanel>
                            <StackPanel Height="Auto" Width="Auto" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Date, StringFormat={}{0:d MMMM}}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" HorizontalAlignment="Center" FontSize="8" Foreground="Gray"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Date, StringFormat={}{0:HH:mm}}" Margin="10" VerticalAlignment="Center" FontSize="22"/>
                        </StackPanel>
                    </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <TextBlock Text="Orders" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
                <ListBox x:Name="ProductListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0 30 0 0" Background="FloralWhite">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                        <StackPanel Height="150" Width="400">
                            <TextBlock FontSize="18" FontWeight="Bold" Text="Order" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding PreferedDate, StringFormat={}{0:dd.MM.yyyy}}" HorizontalAlignment="Center"/>
                            <ListBox ItemsSource="{Binding ProductsOrder}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" Height="100" Background="FloralWhite">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Products.Name}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                    </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
        </StackPanel>
    </Grid>
</Page>
