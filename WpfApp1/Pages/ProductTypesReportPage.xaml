<Page x:Class="WpfApp1.Pages.ProductTypesReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductTypesReportPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Анализ структуры ассортимента по типам товаров" 
                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Табличный отчет -->
        <DataGrid Grid.Row="1" Grid.Column="0" x:Name="DgReport" AutoGenerateColumns="False" 
                  IsReadOnly="True" Margin="0,0,15,0" VerticalAlignment="Top" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип товара" Binding="{Binding TypeName}" Width="*"/>
                <DataGridTextColumn Header="Кол-во наименований" Binding="{Binding ProductCount}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Независимый линейный график -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Визуализация долей категорий" Padding="10" FontSize="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IcProductChart">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,5,0,10">
                                <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <Grid>
                                    <ProgressBar Value="{Binding ProductCount, Mode=OneWay}" 
                                                 Maximum="{Binding ElementName=IcProductChart, Path=DataContext.MaxCount, Mode=OneWay}" 
                                                 Height="25" Foreground="LightCoral" Background="#F0F0F0"/>
                                    <TextBlock Text="{Binding ProductCount, StringFormat='Товаров: {0}'}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                                               FontWeight="Bold" Foreground="Black"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Page>
