<Page x:Class="WpfApp1.Pages.MastersLoadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MastersLoadPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Анализ количества услуг по мастерам" 
                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Табличный отчет -->
        <DataGrid Grid.Row="1" Grid.Column="0" x:Name="DgMasters" AutoGenerateColumns="False" 
                  IsReadOnly="True" Margin="0,0,15,0" VerticalAlignment="Top" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Мастер" Binding="{Binding MasterName}" Width="*"/>
                <DataGridTextColumn Header="Кол-во услуг" Binding="{Binding ServicesCount}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кастомный График нагрузки -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Распределение оказываемых услуг" Padding="10" FontSize="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IcMastersChart">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,5,0,10">
                                <TextBlock Text="{Binding MasterName}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <Grid>
                                    <ProgressBar Value="{Binding ServicesCount, Mode=OneWay}" 
                                               Maximum="{Binding ElementName=IcMastersChart, Path=DataContext.MaxServices, Mode=OneWay}" 
                                               Height="25" Foreground="LightGreen" Background="#F0F0F0"/> 
                                    <TextBlock Text="{Binding ServicesCount, StringFormat='Услуг: {0}'}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                                               FontWeight="Bold" Foreground="Black"/>
                                    </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Page>
