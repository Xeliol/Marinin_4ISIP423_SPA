<Page x:Class="WpfApp1.Pages.MasterAccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MasterAccountPage">

    <Grid Background="FloralWhite">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" FontSize="24" FontWeight="Bold" VerticalAlignment="Top" Foreground="White" Background="MediumPurple" TextAlignment="Center">Master Account</TextBlock>
        <StackPanel x:Name="MoviePanel" Grid.Column="0" Grid.Row="1" VerticalAlignment="Top">
            <Image Source="{Binding ImagePath}" Width="Auto"/>
            <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Login, StringFormat=Name: {0}}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Phone, StringFormat=Phone: {0}}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Email, StringFormat=Email: {0}}" HorizontalAlignment="Center"/>
            <Button x:Name="LogOutButton"  Width="100" BorderBrush="White" BorderThickness="2" Background="MediumPurple" Foreground="White" Click="LogOutButton_Click">Log Out</Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <TextBlock Text="Appointments" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
            <ListBox x:Name="SessionListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0 30 0 0" Background="FloralWhite">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <StackPanel Height="Auto" Width="Auto" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Date, StringFormat={}{0:d MMMM}}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" HorizontalAlignment="Center" FontSize="8" Foreground="Gray"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Date, StringFormat={}{0:HH:mm}}" Margin="10" HorizontalAlignment="Center" FontSize="22"/>
                            <TextBlock Text="{Binding Users.Name}" Margin="10" HorizontalAlignment="Center"/>
                            <Button Width="100" BorderBrush="White" BorderThickness="2" Background="MediumPurple" Foreground="White" Click="FinishButton_Click">Finish</Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <TextBlock Text="Services" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
            <ListBox x:Name="ServiceListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0 30 0 0" Background="FloralWhite">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Height="Auto" Width="Auto" Orientation="Horizontal">
                            <StackPanel Height="Auto" Width="Auto" Margin="10">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Description}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Price, StringFormat={}{0} Rub.}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Button Margin="10" Width="100" BorderBrush="White" BorderThickness="2" Background="MediumPurple" Foreground="White" Click="EditButton_Click">Edit</Button>
                            <Button Margin="10" Width="50" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center" Height="50" Foreground="White" Background="Red" Click="RemoveButton_Click">x</Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
