<Page x:Class="WpfApp1.Pages.AppointmentsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentsTabPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="377*"/>
            <RowDefinition Height="73*"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="1" x:Name="DataGridAppointments" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Записи" Binding="{Binding AppointmentID}" Width="80"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Users.Name}" Width="200"/>
                <DataGridTextColumn Header="Услуга" Binding="{Binding Services.Name}" Width="200"/>
                <DataGridTextColumn Header="Дата и время" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                <DataGridCheckBoxColumn Header="Бронь" Binding="{Binding Reserved}" Width="80"/>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" Content="Редактировать" ToolTip="Редактировать запись" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="ButtonAdd" Padding="15" ToolTip="Добавить запись" Content="Добавить" Click="ButtonAdd_Click"/>
            <Button x:Name="ButtonDel" Padding="15" ToolTip="Удалить запись" Content="Удалить" Click="ButtonDel_Click"/>
        </StackPanel>
    </Grid>
</Page>
