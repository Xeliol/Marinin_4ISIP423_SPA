<Page x:Class="WpfApp1.Pages.ServicesTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ServicesTabPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="377*"/>
            <RowDefinition Height="73*"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="1" x:Name="DataGridServices" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название услуги" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding ServiceTypes.Name}" Width="130"/>
                <DataGridTextColumn Header="Мастер" Binding="{Binding Users.Name}" Width="180"/>
                <DataGridTextColumn Header="Стоимость (руб.)" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="110"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTemplateColumn Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" Content="Редактировать" ToolTip="Редактировать услугу" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="ButtonAdd" Padding="15" ToolTip="Добавить новую услугу" Content="Добавить" Click="ButtonAdd_Click"/>
            <Button x:Name="ButtonDel" Padding="15" ToolTip="Удалить выбранные услуги" Content="Удалить" Click="ButtonDel_Click"/>
        </StackPanel>
    </Grid>
</Page>
