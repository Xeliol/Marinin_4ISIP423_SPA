<Page x:Class="WpfApp1.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" FontSize="24" TextAlignment="Center" FontWeight="Bold" Grid.ColumnSpan="2">Вход</TextBlock>
        <StackPanel Grid.Row="1" Width="300" Height="300">
            <TextBlock FontSize="18" FontWeight="Bold" Text="Вход" HorizontalAlignment="Center"/>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="labelLogin" FontSize="18" Text="Логин: " HorizontalAlignment="Center"/>
                <TextBox x:Name="LoginBox" Width="200" ToolTip="Введите логин"></TextBox>
            </StackPanel>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="labelPass" FontSize="18" Text="Пароль: " HorizontalAlignment="Center"/>
                <PasswordBox x:Name="PassBox" Width="200" ToolTip="Введите пароль"></PasswordBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="12" Text="Нет аккаунта?" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="regButton" Margin="5 10" Click="Button_Click">Зарегистрируйтесь!</Button>
            </StackPanel>
            <Button x:Name="LoginButton" Margin="0 10" Width="100" Click="LoginButton_Click">Войти</Button>
        </StackPanel>
        <StackPanel Grid.Row="1"  Grid.Column="2" Width="250" Height="300">
            <Label Content="Капча:"
                Visibility="Hidden"
                Name="labelCaptcha"
                FontSize="16"
                HorizontalAlignment="Left"
                Width="54" />
            <TextBox
                CommandManager.PreviewExecuted="textBox_PreviewExecuted"
                ContextMenu="{x:Null}"
                Visibility="Hidden"
                x:Name="captcha"
                Height="42"
                Foreground="Red"
                FontStyle="Italic"
                FontWeight="Heavy"
                VerticalAlignment="Top"
                Width="156"
                Background="{x:Null}"
                FontStretch="UltraCondensed"
                IsReadOnly="True"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="20"/>
            <TextBox
                Visibility="Hidden"
                x:Name="captchaInput"
                HorizontalAlignment="Center"
                Height="34"
                TextWrapping="Wrap"
                Text=""
                VerticalAlignment="Top"
                Width="160" />
            <Button x:Name="submitCaptcha"
                Visibility="Hidden"
                Height="34"
                Content="Подтвердить"
                ToolTip="Подтвердить ввод капчи"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Width="120"
                VerticalAlignment="Top"
                Grid.Column="1"
                Click="submitCaptcha_Click" />
        </StackPanel>
    </Grid>
</Page>
