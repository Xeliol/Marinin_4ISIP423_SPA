<Page x:Class="WpfApp1.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid Background="FloralWhite">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="24" TextAlignment="Center" FontWeight="Bold" Background="MediumPurple" Foreground="White">Logging in</TextBlock>
        <StackPanel Grid.Row="1" Width="300" Height="300">
            <TextBlock FontSize="18" FontWeight="Bold" Text="Log in" HorizontalAlignment="Center"/>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="Username: " HorizontalAlignment="Center"/>
                <TextBox x:Name="LoginBox" Width="200"></TextBox>
            </StackPanel>
            <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="18" Text="Password: " HorizontalAlignment="Center"/>
                <TextBox x:Name="PassBox" Width="200"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="12" Text="Don't have an account?" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Margin="5 10" BorderBrush="White" BorderThickness="2" Background="MediumPurple" Foreground="White" Click="Button_Click">Sign up!</Button>
            </StackPanel>
            <Button x:Name="LoginButton" Margin="0 10" Width="100" BorderBrush="White" BorderThickness="2" Background="MediumPurple" Foreground="White" Click="LoginButton_Click">Log in</Button>
        </StackPanel>
    </Grid>
</Page>
